<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>BYOMUSIC — Reels</title><link rel="icon" href="music/profile.png"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>body{margin:0;background:#08090d;color:#fff;font:14px Inter,system-ui,Arial}header{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:rgba(8,9,13,.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.12)}.brand{font-weight:1000;font-size:19px}.brand span{color:#ffcf33}.btn{border:1px solid rgba(255,255,255,.2);background:#ffffff12;padding:9px 13px;border-radius:999px;color:#fff;font-weight:750;font-size:12px;text-decoration:none}.feed{max-width:420px;margin:0 auto;padding:10px 10px 100px}.reel{position:relative;border-radius:20px;overflow:hidden;background:#171923;border:1px solid rgba(255,255,255,.12);margin-bottom:16px;scroll-snap-align:start}.reel video{width:100%;aspect-ratio:9/16;object-fit:cover;background:#000;display:block}.reel-info{position:absolute;left:0;right:0;bottom:0;padding:14px;background:linear-gradient(transparent,rgba(0,0,0,.85))}.reel-info b{display:block}.reel-info p{color:#d4d7df;font-size:12px;margin:4px 0}.reel-actions{position:absolute;right:10px;bottom:110px;display:flex;flex-direction:column;gap:10px}.act{width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.5);backdrop-filter:blur(10px);color:#fff;font-size:16px}.bottomnav{position:fixed;bottom:0;left:0;right:0;background:rgba(10,11,16,.96);display:flex;justify-content:space-around;padding:10px 4px calc(10px + env(safe-area-inset-bottom));border-top:1px solid rgba(255,255,255,.12);z-index:30}.bottomnav a{color:#9299a8;font-size:10px;display:flex;flex-direction:column;gap:4px;align-items:center;text-decoration:none}.bottomnav a.active{color:#ffcf33}.empty{padding:50px;text-align:center;color:#aab0c0}</style></head>
<body><header><div class="brand">BYO<span>MUSIC</span> • Reels</div><a class="btn" href="index.html">← Home</a></header>
<div style="max-width:420px;margin:10px auto 0;padding:0 10px"><input id="q" oninput="render()" placeholder="Search reels, artists..." style="width:100%;padding:12px;border-radius:999px;border:1px solid rgba(255,255,255,.15);background:#ffffff0d;color:#fff;outline:0"></div>
<div class="feed" id="feed"><div class="empty">Loading reels…</div></div>
<nav class="bottomnav"><a href="index.html"><i class="fa fa-house"></i>Home</a><a href="search.html"><i class="fa fa-search"></i>Search</a><a class="active" href="reels.html"><i class="fa fa-clapperboard"></i>Reels</a><a href="albums.html"><i class="fa fa-record-vinyl"></i>Albums</a><a href="library.html"><i class="fa fa-book"></i>Library</a></nav>
<script>
const GH="https://raw.githubusercontent.com/byosites/-BYOMusic/main/data";
let reels=[], liked=new Set(JSON.parse(localStorage.getItem("byo_reel_likes")||"[]"));
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
async function load(){try{let r=await fetch(GH+"/reels.json?t="+Date.now());if(r.ok) reels=await r.json();}catch(e){} render();}
function render(){let q=(document.getElementById("q").value||"").toLowerCase();let list=reels.filter(r=>!r.hidden && (`${r.title} ${r.artist} ${r.caption}`.toLowerCase().includes(q)));document.getElementById("feed").innerHTML=list.length?list.map((r,i)=>`<div class="reel"><video src="${r.video}" poster="${r.cover||''}" playsinline loop preload="metadata" onclick="this.paused?this.play():this.pause()"></video><div class="reel-actions"><button class="act" onclick="likeReel('${r.id}',this)">${liked.has(r.id)?"❤️":"🤍"}<div style="font-size:10px">${(r.likes||0)+(liked.has(r.id)?1:0)}</div></button><button class="act" onclick="shareReel('${r.id}')">↗</button></div><div class="reel-info"><b>🎬 ${esc(r.title||"Reel")}</b><p>@${esc(r.artist||"BYOMUSIC")} • ${esc(r.caption||"")}</p><p style="color:#ffcf33">▶ Tap video to play / pause</p></div></div>`).join(""):`<div class="empty">No reels yet. Check back soon.</div>`;}
function likeReel(id,btn){if(liked.has(id)) liked.delete(id); else liked.add(id);localStorage.setItem("byo_reel_likes",JSON.stringify([...liked]));render();}
function shareReel(id){let r=reels.find(x=>x.id===id);window.open("https://wa.me/?text="+encodeURIComponent("Watch this BYOMUSIC Reel: "+r.title+" by "+r.artist+" https://byomusic.pages.dev/reels.html"),"_blank");}
load();
</script></body></html>