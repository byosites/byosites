<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>BYOMUSIC — Albums</title><link rel="icon" href="music/profile.png"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>body{margin:0;background:#08090d;color:#fff;font:14px Inter,system-ui,Arial;padding-bottom:100px}header{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:rgba(8,9,13,.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.12)}.brand{font-weight:1000;font-size:19px}.brand span{color:#ffcf33}.btn{border:1px solid rgba(255,255,255,.2);background:#ffffff12;padding:9px 13px;border-radius:999px;color:#fff;font-weight:750;font-size:12px;text-decoration:none}.wrap{max-width:1100px;margin:auto;padding:14px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px}.card{background:#ffffff0b;border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:11px;cursor:pointer}.card img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px}.card h3{margin:10px 0 4px;font-size:13px}.card p{color:#aab0c0;font-size:11px;margin:0}.modal{display:none;position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.7);align-items:end;justify-content:center}.modal.show{display:flex}.box{width:min(620px,100%);max-height:88vh;overflow:auto;background:#1b1e2a;border-radius:22px 22px 0 0;padding:20px}.row{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.1)}.row img{width:44px;height:44px;object-fit:cover;border-radius:8px}.row .g{flex:1}.bottomnav{position:fixed;bottom:0;left:0;right:0;background:rgba(10,11,16,.96);display:flex;justify-content:space-around;padding:10px 4px calc(10px + env(safe-area-inset-bottom));border-top:1px solid rgba(255,255,255,.12);z-index:30}.bottomnav a{color:#9299a8;font-size:10px;display:flex;flex-direction:column;gap:4px;align-items:center;text-decoration:none}.bottomnav a.active{color:#ffcf33}.empty{padding:40px;text-align:center;color:#aab0c0}audio{width:100%}</style></head>
<body><header><div class="brand">BYO<span>MUSIC</span> • Albums</div><a class="btn" href="index.html">← Home</a></header>
<div class="wrap"><h1 style="font-size:26px">Albums</h1><p style="color:#aab0c0">Full albums from Zimbabwean artists.</p><input id="q" oninput="render()" placeholder="Search albums, artists..." style="width:100%;padding:12px;border-radius:999px;border:1px solid rgba(255,255,255,.15);background:#ffffff0d;color:#fff;outline:0;margin-bottom:14px"><div class="grid" id="grid"><div class="empty">Loading albums…</div></div></div>
<div class="modal" id="modal" onclick="if(event.target===this)closeM()"><div class="box"><button class="btn" style="float:right" onclick="closeM()">✕</button><div id="detail"></div></div></div>
<nav class="bottomnav"><a href="index.html"><i class="fa fa-house"></i>Home</a><a href="search.html"><i class="fa fa-search"></i>Search</a><a href="reels.html"><i class="fa fa-clapperboard"></i>Reels</a><a class="active" href="albums.html"><i class="fa fa-record-vinyl"></i>Albums</a><a href="library.html"><i class="fa fa-book"></i>Library</a></nav>
<script>
const GH="https://raw.githubusercontent.com/byosites/-BYOMusic/main/data";
let albums=[],songs=[];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
async function load(){try{let [a,s]=await Promise.all([fetch(GH+"/albums.json?t="+Date.now()).then(r=>r.json()),fetch(GH+"/songs.json?t="+Date.now()).then(r=>r.json())]);albums=a;songs=s;}catch(e){} render();}
function render(){let q=(document.getElementById("q").value||"").toLowerCase();let list=albums.filter(a=>!a.hidden && (`${a.title} ${a.artist}`.toLowerCase().includes(q)));document.getElementById("grid").innerHTML=list.length?list.map(a=>`<div class="card" onclick="openAlbum('${a.id}')"><img src="${a.cover||'music/profile.png'}" onerror="this.src='music/profile.png'"><h3>${esc(a.title)}</h3><p>${esc(a.artist)} • ${a.songIds?a.songIds.length:0} songs • ${esc(a.year||"")}</p><p style="color:#ffcf33">${a.price?esc(a.price)+" • ":""}Tap to open →</p></div>`).join(""):`<div class="empty">No albums yet.</div>`;}
function openAlbum(id){let a=albums.find(x=>x.id===id);if(!a)return;let tracks=(a.songIds||[]).map(sid=>songs.find(s=>s.id===sid)).filter(Boolean);document.getElementById("detail").innerHTML=`<img src="${a.cover||'music/profile.png'}" style="width:100%;max-height:220px;object-fit:cover;border-radius:14px"><h2>${esc(a.title)}</h2><p style="color:#ffcf33">${esc(a.artist)} • ${esc(a.year||"")} • ${tracks.length} tracks</p><p style="color:#aab0c0">${esc(a.description||"")}</p><audio id="ap" controls></audio><div>${tracks.map((t,i)=>`<div class="row"><img src="${t.cover||a.cover}"><div class="g"><b>${esc(t.title)}</b><br><small style="color:#aab0c0">${esc(t.artist)}</small></div><button class="btn" onclick="playTrack('${t.id}')">▶ Play</button></div>`).join("")||"<p style='color:#aab0c0'>No tracks in this album yet.</p>"}</div>`;document.getElementById("modal").classList.add("show");}
function playTrack(id){let t=songs.find(s=>s.id===id);let a=document.getElementById("ap");a.src=t.audio;a.play();}
function closeM(){document.getElementById("modal").classList.remove("show");}
load();
</script></body></html>